# admin/ SECRETS template. Copy to:
#   admin/.env.development.local  — `npm run dev` (values from the DEV Supabase project)
#   admin/.env.production.local   — local production build only
# In production (AWS Amplify) these are the app's Environment Variables
# (prod values). Non-secret settings (app URLs,
# APP_ENV) are committed in admin/.env.development and admin/.env.production.

# Supabase — the environment's own project. Browser (auth):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (API routes). NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
