# Supabase — client-side auth needs the NEXT_PUBLIC_ prefix so the browser can read it
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by the /api/register-company route to write the companies
# table and read auth user metadata. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# web/ app URL, for the top nav's cross-link
NEXT_PUBLIC_WEB_URL=http://localhost:3000
