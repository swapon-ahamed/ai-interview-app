# Committed, NON-SECRET defaults for production builds and the production AWS
# Amplify app (ai-interview-admin, branch master). Secrets live in Amplify's
# environment variables (or admin/.env.production.local locally). The Amplify
# build appends its env vars to this file, so Amplify values win on conflicts.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_ADMIN_URL=https://ai-interview-admin.swapon-ahamed.me
NEXT_PUBLIC_WEB_URL=https://ai-interview.swapon-ahamed.me
