# agent/ secrets — one file per environment at the REPO ROOT (gitignored):
#   .env.development   used by `python main.py dev` (APP_ENV defaults to development)
#   .env.production    used on the Lightsail server (systemd sets APP_ENV=production)
# Copy this template to each and fill in that environment's values.
# NEVER commit these files or paste real keys into chat/screenshots.

# LiveKit Cloud — ONE project shared by both environments. Dev and prod are
# kept apart by the worker name (see LIVEKIT_AGENT_NAME), not by keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Optional: defaults to ai-interviewer-dev / ai-interviewer-prod from APP_ENV.
# Must match LIVEKIT_AGENT_NAME in web/.env.development / web/.env.production.
# LIVEKIT_AGENT_NAME=

# OpenAI (can be the same key in both, or separate keys to split usage/billing)
OPENAI_API_KEY=

# Supabase — DIFFERENT project per environment:
#   development -> ai-interview-dev project
#   production  -> ai-interview-app project (the original one)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
