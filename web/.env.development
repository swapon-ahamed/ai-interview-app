# Committed, NON-SECRET defaults for `next dev` (development environment).
# Secrets (Supabase keys, LiveKit keys) go in web/.env.development.local —
# see web/.env.example. Never put a secret in this file.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Must match the agent's LIVEKIT_AGENT_NAME for this environment (agent/main.py).
LIVEKIT_AGENT_NAME=ai-interviewer-dev
