# web/ SECRETS template. Copy to:
#   web/.env.development.local  — `npm run dev` (values from the DEV Supabase project)
#   web/.env.production.local   — local `npm run build && npm start` only
# In production (AWS Amplify) these are the app's Environment Variables
# (prod values). Non-secret settings (site URL,
# admin URL, agent name, APP_ENV) are committed in web/.env.development and
# web/.env.production — don't repeat them here.

# LiveKit Cloud (same project for both environments)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Supabase — the environment's own project. Server-side (API routes):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/anon key, exposed to the browser for company sign-in:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: cap on new free practice sessions per hour, site-wide (default 300)
# PRACTICE_GLOBAL_HOURLY_LIMIT=
