# Committed, NON-SECRET defaults for `next build` / `next start` and the
# production AWS Amplify app (ai-interview-web, branch master). Secrets live in
# Amplify's environment variables (or web/.env.production.local for a local
# production build). Never put a secret in this file. The Amplify build
# appends its env vars to this file, so Amplify values win on conflicts.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://ai-interview.swapon-ahamed.me
NEXT_PUBLIC_ADMIN_URL=https://ai-interview-admin.swapon-ahamed.me
# Must match the agent's LIVEKIT_AGENT_NAME on the production server.
LIVEKIT_AGENT_NAME=ai-interviewer-prod
